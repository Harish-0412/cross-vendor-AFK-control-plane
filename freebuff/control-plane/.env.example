# FreeBuff Control Plane Environment Configuration

CONTROL_PLANE_PORT=4000
CONTROL_PLANE_HOST=0.0.0.0

# Secret used to sign local tokens and Gateway tokens
JWT_SECRET=freebuff-dev-secret-key-replace-in-production-min-32-chars

# Set to true to store users, devices, sessions, approvals, and audit records in Cloud Firestore
USE_FIRESTORE=true

# Firebase Admin SDK Credentials (from Firebase Console -> Project Settings -> Service Accounts)
# Option A: Direct fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Path to downloaded Service Account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Phase 7 Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
