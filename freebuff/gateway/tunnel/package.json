{
  "name": "@freebuff/tunnel",
  "version": "0.1.0",
  "private": true,
  "description": "Tunnel Client stub for Freebuff Gateway - outbound connection framework (Phase 2 foundation)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --dir src",
    "test:integration": "vitest run --config vitest.config.ts --dir tests",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@freebuff/protocol": "workspace:*",
    "@freebuff/config": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^1.5.0"
  }
}
