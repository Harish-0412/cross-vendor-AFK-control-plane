{
  "name": "@freebuff/pairing",
  "version": "0.1.0",
  "private": true,
  "description": "Pairing flow, code generation, session management, and pairing state machine for Freebuff Gateway",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
