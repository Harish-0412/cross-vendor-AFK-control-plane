{
  "name": "@freebuff/config",
  "version": "0.1.0",
  "description": "Shared configuration for Freebuff AFK Control Plane",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@freebuff/protocol": "workspace:*",
    "@freebuff/schemas": "workspace:*"
  }
}
