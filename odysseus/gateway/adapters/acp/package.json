    "typecheck": "tsc --build --dry"
  },
  "dependencies": {
    "@odysseus/policy-engine": "workspace:*",
    "@odysseus/protocol": "workspace:*"
  },
  "devDependencies": { "@types/node": "^20.12.0", "vitest": "^1.5.0" }
}
