{
  "name": "@odysseus/acp-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "One adapter for every agent that speaks the Agent Client Protocol (ACP)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./src/index.ts" } },
  "scripts": {
    "build": "tsc --build",
