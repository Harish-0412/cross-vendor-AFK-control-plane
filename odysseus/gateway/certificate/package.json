{
  "name": "@odysseus/certificate",
  "version": "0.1.0",
  "private": true,
  "description": "Device certificate management, signing, rotation, revocation for Odysseus Gateway",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc -w",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --build --dry"
  },
  "dependencies": {
    "@odysseus/protocol": "workspace:*",
    "@odysseus/schemas": "workspace:*",
    "@odysseus/config": "workspace:*",
    "@odysseus/identity": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^1.5.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
