{
  "name": "@odysseus/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Consent-gated access to external tool history and usage (Antigravity, Codex, ChatGPT export, OpenAI org)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --dry",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@odysseus/protocol": "workspace:*",
    "@odysseus/redaction": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "vitest": "^1.5.0"
  }
}
