{
  "name": "@odysseus/config",
  "version": "0.1.0",
  "description": "Shared configuration for Odysseus AFK Control Plane",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "typecheck": "tsc --build --dry",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@odysseus/protocol": "workspace:*",
    "@odysseus/schemas": "workspace:*"
  }
}
