{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": [
    "Shared compiler options for every package in the workspace.",
    "Deliberately contains no `paths`: cross-package imports resolve through",
    "each package's `exports`/`types` field to its built `dist/*.d.ts`, which is",
    "what keeps `rootDir: src` valid. Tests bypass this and alias straight to",
    "source via vitest.shared.ts, so no build is needed to run them."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
