{
  "name": "@harish-0412/odysseus-gateway",
  "version": "0.1.1",
  "description": "Lightweight local gateway for the Odysseus cross-vendor AI coding control plane",
  "type": "module",
  "bin": {
    "odysseus": "bin/odysseus.mjs"
  },
  "files": [
    "bin",
    "dist-package",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harish-0412/cross-vendor-AFK-control-plane.git",
    "directory": "odysseus"
  },
  "homepage": "https://github.com/Harish-0412/cross-vendor-AFK-control-plane#odysseus-gateway-package",
  "bugs": {
    "url": "https://github.com/Harish-0412/cross-vendor-AFK-control-plane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "build:force": "tsc --build --force",
    "dev": "tsc --build --watch",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "tsc --build --dry",
    "clean": "tsc --build --clean && pnpm -r clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "package:build": "node scripts/build-gateway-package.mjs",
    "prepack": "pnpm package:build",
    "gateway": "tsx scripts/start-gateway.ts",
    "pair": "tsx scripts/pair.ts",
    "grants": "tsx scripts/grants.ts",
    "import": "tsx scripts/import.ts",
    "openai-org": "tsx scripts/openai-org.ts",
    "verify:deploy": "tsx scripts/verify-deploy.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.5.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "ws": "^8.21.3",
    "yaml": "^2.4.0"
  }
}
