# Auth provider: "local" (Control Plane JWT auth) or "firebase" (Firebase Authentication).
# Use "firebase" only when the Control Plane has Firebase admin credentials configured,
# otherwise ID tokens cannot be verified and every API call returns 401.
NEXT_PUBLIC_AUTH_PROVIDER=local

# Local development.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Deployed: point both at the Control Plane origin and use https/wss.
# A page served over HTTPS cannot open a ws:// socket — browsers block mixed
# content — so a missed wss:// here produces a frontend that loads fine and is
# silently realtime-dead. See docs/DEPLOYMENT.md.
#   NEXT_PUBLIC_API_URL=https://odysseus-control-plane.onrender.com
#   NEXT_PUBLIC_WS_URL=wss://odysseus-control-plane.onrender.com


# Phase 7 Web Push (generate with: npx web-push generate-vapid-keys, then set the
# same PUBLIC key in the control plane's .env as VAPID_PUBLIC_KEY)
# Leave empty to disable push subscription in the UI.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Firebase Web App Config (Fill these in with your Firebase Console project values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
